---
// Navbar.astro
// Fixed top navigation. Name on left, section links on right.
const navLinks = [
  { label: "Research", href: "/#research" },
  { label: "Projects", href: "/#projects" },
  { label: "Blog",     href: "/blog" },
  { label: "Contact",  href: "/#contact" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-[#fafafa]/90 backdrop-blur-sm border-b border-gray-100">
  <nav class="max-w-3xl mx-auto px-6 h-14 flex items-center justify-between">

    <a href="/" class="font-sans text-sm font-semibold text-gray-900 tracking-tight hover:text-indigo-500 transition-colors">
      Lukas Frotton
    </a>

    <ul class="flex items-center gap-8 list-none m-0 p-0">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm font-sans text-gray-500 hover:text-gray-900 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

  </nav>
</header>