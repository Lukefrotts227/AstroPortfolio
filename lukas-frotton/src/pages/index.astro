---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { work } from '../data/work';
import { bio } from '../data/bio';
import { contact } from '../data/contact';

const tagStyles: Record<string, string> = {
  // Type
  research:    "bg-indigo-50 text-indigo-500",
  project:     "bg-gray-100 text-gray-500",
  job:         "bg-amber-50 text-amber-600",
  lab:         "bg-emerald-50 text-emerald-600",
  independent: "bg-violet-50 text-violet-500",
  // Domain
  ml:          "bg-violet-50 text-violet-500",
  systems:     "bg-stone-100 text-stone-500",
  fullstack:   "bg-sky-50 text-sky-500",
  data:        "bg-cyan-50 text-cyan-600",
  robotics:    "bg-rose-50 text-rose-500",
  teaching:    "bg-lime-50 text-lime-600",
  leadership:  "bg-orange-50 text-orange-500",
  automation:  "bg-teal-50 text-teal-600",
  // Stack
  python:      "bg-blue-50 text-blue-500",
  rust:        "bg-orange-50 text-orange-600",
  javascript:  "bg-yellow-50 text-yellow-600",
  typescript:  "bg-blue-50 text-blue-600",
  cpp:         "bg-gray-100 text-gray-600",
};

const featured = work.filter(item => item.featured);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lukas Frotton</title>
  <meta name="description" content={bio.intro} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <style>
    body        { font-family: 'Lora', serif; background-color: #fafafa; color: #111; }
    h1, h2, h3,
    nav, button { font-family: 'DM Sans', sans-serif; }
    html        { scroll-behavior: smooth; }
  </style>
</head>

<body class="bg-[#fafafa] text-[#111]">
  <Navbar />

  <main class="max-w-5xl mx-auto px-6 sm:px-10 lg:px-16 pt-28 pb-32 space-y-28">

    <!-- ========== INTRO ========== -->
    <section id="intro">
      <div class="flex flex-col sm:flex-row items-start gap-8 sm:gap-12">

        <!-- Photo -->
        <div class="shrink-0">
          <img
            src={bio.photo}
            alt="Lukas Frotton"
            class="w-36 h-36 sm:w-44 sm:h-44 rounded-lg object-cover object-top grayscale-[15%]"
          />
        </div>

        <!-- Text -->
        <div class="flex flex-col justify-center min-w-0">
          <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-gray-900 mb-2">
            Lukas Frotton
          </h1>

          <!-- Status line — edit in bio.ts -->
          {bio.status && (
            <p class="font-sans text-xs text-emerald-600 mb-3 flex items-center gap-1.5">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              {bio.status}
            </p>
          )}

          <!-- Intro bio — edit in bio.ts -->
          {bio.intro && (
            <p class="text-gray-600 leading-relaxed mb-5 text-sm sm:text-base">{bio.intro}</p>
          )}

          <!-- Quick links -->
          <div class="flex flex-wrap gap-x-4 gap-y-2 font-sans text-sm">
            {bio.resumes.map((r: {label: string, file: string}) => (
              <a href={r.file} class="text-indigo-500 hover:text-indigo-700 transition-colors">{r.label} ↗</a>
            ))}
            <a href="/#contact" class="text-indigo-500 hover:text-indigo-700 transition-colors">Contact</a>
            {contact.links.map((l: {label: string, url: string}) => (
              <a href={l.url} target="_blank" class="text-indigo-500 hover:text-indigo-700 transition-colors">{l.label} ↗</a>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ========== FEATURED ========== -->
    {featured.length > 0 && (
      <section id="featured">
        <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Highlights</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {featured.map(item => (
            <div class="border border-gray-200 rounded-lg p-5 hover:border-indigo-200 transition-colors">
              <div class="flex flex-wrap gap-2 mb-3">
                {item.tags.slice(0, 2).map((tag: string) => (
                  <span class={`font-sans text-xs px-2 py-0.5 rounded-full ${tagStyles[tag] ?? 'bg-gray-100 text-gray-500'}`}>
                    {tag}
                  </span>
                ))}
              </div>
              <div class="flex items-baseline gap-x-2 mb-1">
                <h3 class="font-sans text-sm font-semibold text-gray-900">{item.title}</h3>
                {item.links.length > 0 && (
                  <div class="flex items-center gap-x-2">
                    {item.links.map((link: {label: string, url: string}) => (
                      <a href={link.url} target="_blank" class="font-sans text-xs text-indigo-400 hover:text-indigo-600 transition-colors">
                        {link.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
              {item.summary && (
                <p class="text-xs text-gray-500 leading-relaxed">{item.summary}</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ========== WORK ========== -->
    <section id="work">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Work</h2>

      <div class="space-y-12">
        {work.map(item => (
          <div class="group">

            {/* ── Header row: title + links ── */}
            <div class="flex items-baseline gap-x-3 mb-1">
              <h3 class="font-sans text-base font-semibold text-gray-900">
                {item.title}
              </h3>
              {item.links.length > 0 && (
                <div class="flex items-center gap-x-3">
                  {item.links.map((link: {label: string, url: string}) => (
                    <a href={link.url} target="_blank" class="font-sans text-xs text-indigo-400 hover:text-indigo-600 transition-colors shrink-0">
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              )}
            </div>

            {/* ── Meta row: org · location · date · status ── */}
            <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mb-2 font-sans text-xs text-gray-400">
              {item.organization && <span>{item.organization}</span>}
              {item.organization && (item.location || item.dateRange || item.year) && <span>·</span>}
              {item.location && <span>{item.location}</span>}
              {item.location && (item.dateRange || item.year) && <span>·</span>}
              <span>{item.dateRange ?? item.year}</span>
              {item.status === "ongoing" && (
                <span class="text-emerald-500 ml-1">· ongoing</span>
              )}
            </div>

            {/* ── Tags ── */}
            <div class="flex flex-wrap gap-2 mb-3">
              {item.tags.map((tag: string) => (
                <span class={`font-sans text-xs px-2 py-0.5 rounded-full ${tagStyles[tag] ?? 'bg-gray-100 text-gray-500'}`}>
                  {tag}
                </span>
              ))}
            </div>

            {/* ── Summary ── */}
            {item.summary && (
              <p class="text-sm font-sans text-gray-700 mb-2 leading-relaxed">{item.summary}</p>
            )}

            {/* ── Description ── */}
            {item.description && (
              <p class="text-gray-600 leading-relaxed text-sm sm:text-base mb-2">{item.description}</p>
            )}

            {/* ── Details ── */}
            {item.details && (
              <p class="text-gray-500 leading-relaxed text-sm mt-2 border-l-2 border-gray-200 pl-4">
                {item.details}
              </p>
            )}

            {/* ── Highlights ── */}
            {item.highlights && item.highlights.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2">
                {item.highlights.map((h: string) => (
                  <li class="font-sans text-xs bg-gray-50 border border-gray-200 rounded px-2 py-1 text-gray-600">
                    {h}
                  </li>
                ))}
              </ul>
            )}

          </div>
        ))}
      </div>
    </section>

    <!-- ========== BACKGROUND ========== -->
    <section id="background">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Background</h2>
      <div class="max-w-2xl">
        {bio.background && (
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">{bio.background}</p>
        )}
      </div>
    </section>

    <!-- ========== MOVING FORWARD ========== -->
    <section id="moving-forward">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Moving Forward</h2>
      <div class="max-w-2xl">
        {bio.movingForward && (
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">{bio.movingForward}</p>
        )}
      </div>
    </section>

    <!-- ========== CONTACT ========== -->
    <section id="contact">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Contact</h2>
      <div class="flex flex-col gap-3 font-sans text-sm">
        <a href={`mailto:${contact.email}`} class="text-gray-700 hover:text-indigo-500 transition-colors">
          {contact.email}
        </a>
        {contact.links.map((l: {label: string, url: string}) => (
          <a href={l.url} target="_blank" class="text-gray-700 hover:text-indigo-500 transition-colors">
            {l.label} ↗
          </a>
        ))}
      </div>
    </section>

  </main>
</body>
</html>