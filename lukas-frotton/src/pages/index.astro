---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lukas Frotton</title>
  <meta name="description" content="ML Researcher · CS + Mathematics · Rutgers University" />

  <!-- Fonts: DM Sans (UI/headings) + Lora (body/blog) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

  <style>
    body        { font-family: 'Lora', serif; background-color: #fafafa; color: #111; }
    h1, h2, h3,
    nav, button { font-family: 'DM Sans', sans-serif; }

    /* Smooth scroll for anchor links */
    html { scroll-behavior: smooth; }
  </style>
</head>

<body class="bg-[#fafafa] text-[#111]">

  <Navbar />

  <main class="max-w-5xl mx-auto px-6 sm:px-10 lg:px-16 pt-28 pb-32 space-y-28">

    <!-- ========== INTRO ========== -->
    <section id="intro" class="max-w-2xl">
      <!-- Your name as the page heading -->
      <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-gray-900 mb-4">
        Lukas Frotton
      </h1>

      <!-- One or two lines on who you are — write your own copy below -->
      <p class="text-lg text-gray-600 leading-relaxed mb-6">
        <!-- e.g. "CS + Mathematics, Rutgers. Researching complex-valued neural networks." -->
      </p>

      <!-- Resume + contact quick links -->
      <div class="flex flex-wrap gap-4 font-sans text-sm">
        <a href="/resume.pdf" class="text-indigo-500 hover:text-indigo-700 transition-colors">Resume ↗</a>
        <a href="/#contact"   class="text-indigo-500 hover:text-indigo-700 transition-colors">Contact</a>
        <a href="https://github.com/Lukefrotts227" target="_blank" class="text-indigo-500 hover:text-indigo-700 transition-colors">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/lukas-frotton-07b79422b/" target="_blank" class="text-indigo-500 hover:text-indigo-700 transition-colors">LinkedIn ↗</a>
      </div>
    </section>

    <!-- ========== RESEARCH ========== -->
    <section id="research">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Research</h2>

      <div class="space-y-10">
        <!-- Repeat this block for each research item -->
        <div>
          <h3 class="font-sans text-base font-semibold text-gray-900 mb-1">
            <!-- Research title here -->
          </h3>
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
            <!-- Description here -->
          </p>
        </div>
      </div>

      <!-- Coursework — sits at the bottom of the research section -->
      <div class="mt-12 pt-8 border-t border-gray-100">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">Relevant Coursework</h3>
        <p class="text-sm text-gray-500 leading-relaxed">
          <!-- Comma-separated list works fine here -->
        </p>
      </div>
    </section>

    <!-- ========== PROJECTS ========== -->
    <section id="projects">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Selected Projects</h2>

      <div class="space-y-10">
        <!-- Repeat this block for each project (3–4 max) -->
        <div>
          <div class="flex items-baseline gap-3 mb-1">
            <h3 class="font-sans text-base font-semibold text-gray-900">
              <a href="#" class="hover:text-indigo-500 transition-colors">
                <!-- Project name — link to repo -->
              </a>
            </h3>
            <span class="font-sans text-xs text-gray-400">
              <!-- Stack e.g. "Python · PyTorch" -->
            </span>
          </div>
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
            <!-- One or two sentences. What it does, what's interesting about it. -->
          </p>
        </div>
      </div>
    </section>

    <!-- ========== MOVING FORWARD ========== -->
    <section id="moving-forward">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Moving Forward</h2>
      <div class="max-w-2xl">
        <p class="text-gray-600 leading-relaxed text-sm sm:text-base">
          <!-- Your "what's next" — gap year, PhD plans, roles you're targeting. Write freely. -->
        </p>
      </div>
    </section>

    <!-- ========== CONTACT ========== -->
    <section id="contact">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Contact</h2>
      <div class="flex flex-col gap-3 font-sans text-sm">
        <a href="mailto:your@email.com" class="text-gray-700 hover:text-indigo-500 transition-colors">
          <!-- your@email.com -->
        </a>
        <a href="https://www.linkedin.com/in/lukas-frotton-07b79422b/" target="_blank" class="text-gray-700 hover:text-indigo-500 transition-colors">
          LinkedIn ↗
        </a>
        <a href="https://github.com/Lukefrotts227" target="_blank" class="text-gray-700 hover:text-indigo-500 transition-colors">
          GitHub ↗
        </a>
      </div>
    </section>

  </main>

</body>
</html>