---
// src/pages/index.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { work } from '../data/work';
import { bio } from '../data/bio';
import { contact } from '../data/contact';

const tagStyles: Record<string, string> = {
  research:  "bg-indigo-50 text-indigo-500",
  ml:        "bg-violet-50 text-violet-500",
  systems:   "bg-stone-100 text-stone-500",
  fullstack: "bg-sky-50 text-sky-500",
  project:   "bg-gray-100 text-gray-500",
  lab:       "bg-emerald-50 text-emerald-600",
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lukas Frotton</title>
  <meta name="description" content={bio.intro} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

  <style>
    body        { font-family: 'Lora', serif; background-color: #fafafa; color: #111; }
    h1, h2, h3,
    nav, button { font-family: 'DM Sans', sans-serif; }
    html        { scroll-behavior: smooth; }
  </style>
</head>

<body class="bg-[#fafafa] text-[#111]">

  <Navbar />

  <main class="max-w-5xl mx-auto px-6 sm:px-10 lg:px-16 pt-28 pb-32 space-y-28">

    <!-- ========== INTRO ========== -->
    <section id="intro" class="max-w-2xl">
      <h1 class="font-sans text-3xl sm:text-4xl font-semibold tracking-tight text-gray-900 mb-4">
        Lukas Frotton
      </h1>

      {bio.intro && (
        <p class="text-lg text-gray-600 leading-relaxed mb-6">{bio.intro}</p>
      )}

      <div class="flex flex-wrap gap-4 font-sans text-sm">
        {bio.resumes.map(r => (
          <a href={r.file} class="text-indigo-500 hover:text-indigo-700 transition-colors">
            {r.label} ↗
          </a>
        ))}
        <a href="/#contact" class="text-indigo-500 hover:text-indigo-700 transition-colors">Contact</a>
        {contact.links.map(l => (
          <a href={l.url} target="_blank" class="text-indigo-500 hover:text-indigo-700 transition-colors">
            {l.label} ↗
          </a>
        ))}
      </div>
    </section>

    <!-- ========== WORK ========== -->
    <section id="work">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Work</h2>

      <div class="space-y-10">
        {work.map(item => (
          <div>
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
              <h3 class="font-sans text-base font-semibold text-gray-900">
                {item.github ? (
                  <a href={item.github} target="_blank" class="hover:text-indigo-500 transition-colors">
                    {item.title} ↗
                  </a>
                ) : (
                  item.title
                )}
              </h3>
              <span class="font-sans text-xs text-gray-400">{item.year}</span>
              {item.status === "ongoing" && (
                <span class="font-sans text-xs text-emerald-500">ongoing</span>
              )}
            </div>

            <div class="flex flex-wrap gap-2 mb-2">
              {item.tags.map(tag => (
                <span class={`font-sans text-xs px-2 py-0.5 rounded-full ${tagStyles[tag] ?? 'bg-gray-100 text-gray-500'}`}>
                  {tag}
                </span>
              ))}
            </div>

            {item.description && (
              <p class="text-gray-600 leading-relaxed text-sm sm:text-base">{item.description}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- ========== BACKGROUND ========== -->
    <section id="background">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Background</h2>
      <div class="max-w-2xl">
        {bio.background && (
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">{bio.background}</p>
        )}
      </div>
    </section>

    <!-- ========== MOVING FORWARD ========== -->
    <section id="moving-forward">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Moving Forward</h2>
      <div class="max-w-2xl">
        {bio.movingForward && (
          <p class="text-gray-600 leading-relaxed text-sm sm:text-base">{bio.movingForward}</p>
        )}
      </div>
    </section>

    <!-- ========== CONTACT ========== -->
    <section id="contact">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-8">Contact</h2>
      <div class="flex flex-col gap-3 font-sans text-sm">
        <a href={`mailto:${contact.email}`} class="text-gray-700 hover:text-indigo-500 transition-colors">
          {contact.email}
        </a>
        {contact.links.map(l => (
          <a href={l.url} target="_blank" class="text-gray-700 hover:text-indigo-500 transition-colors">
            {l.label} ↗
          </a>
        ))}
      </div>
    </section>

  </main>

</body>
</html>