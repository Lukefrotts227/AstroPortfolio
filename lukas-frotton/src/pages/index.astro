---
// src/pages/index.astro
import Navbar from '../components/Navbar.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lukas Frotton</title>
  <meta name="description" content="ML Researcher, CS + Mathematics, Rutgers University" />

  <!-- Google Fonts: DM Sans (headings/nav) + Lora (body/blog) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />

  <style>
    body {
      font-family: 'Lora', serif;
      background-color: #fafafa;
      color: #111;
    }
    h1, h2, h3, nav, .font-sans {
      font-family: 'DM Sans', sans-serif;
    }
  </style>
</head>

<body class="bg-[#fafafa] text-[#111]">

  <Navbar />

  <!-- offset for fixed navbar -->
  <main class="max-w-3xl mx-auto px-6 pt-24 pb-24 space-y-24">

    <!-- INTRO -->
    <section id="intro">
      <!-- Your name, one line on who you are, resume link, contact link -->
      <!-- Write your own copy here -->
    </section>

    <!-- RESEARCH -->
    <section id="research">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Research</h2>
      <!-- Your research content here -->
      <!-- Suggested: one entry per project, title + short description -->
      <!-- Coursework can live at the bottom of this section as a simple list -->
    </section>

    <!-- PROJECTS -->
    <section id="projects">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Selected Projects</h2>
      <!-- 3-4 projects max -->
      <!-- Each: project name (link to repo), one or two sentences, stack note -->
    </section>

    <!-- MOVING FORWARD -->
    <section id="moving-forward">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Moving Forward</h2>
      <!-- Your "what's next" — gap year, PhD plans, what you're targeting -->
      <!-- This is yours to write and update freely -->
    </section>

    <!-- CONTACT -->
    <section id="contact">
      <h2 class="font-sans text-xs font-semibold uppercase tracking-widest text-gray-400 mb-6">Contact</h2>
      <!-- Email link, GitHub, LinkedIn, resume PDF link -->
      <!-- Suggested layout: just a clean list of links, nothing fancy -->
    </section>

  </main>

</body>
</html>